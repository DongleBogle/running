{
  "version": 2,
  "buildCommand": "node scripts/build.mjs web",
  "outputDirectory": "dist/web",
  "redirects": [
    {
      "source": "/home.html",
      "destination": "/"
    },
    {
      "source": "/converter.html",
      "destination": "/converter"
    },
    {
      "source": "/calendar.html",
      "destination": "/calendar"
    }
  ],
  "rewrites": [
    {
      "source": "/api/youtube/analyze",
      "destination": "/api/analyze"
    },
    {
      "source": "/api/race/videos",
      "destination": "/api/race_videos"
    },
    {
      "source": "/:view(converter|calendar)",
      "destination": "/:view.html"
    },
    {
      "source": "/race/:id",
      "destination": "/race/:id.html"
    }
  ],
  "trailingSlash": false
}
